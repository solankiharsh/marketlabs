# Zing Backend — copy to .env and fill in values.
# See ENV_KEYS.md for where to get each key.

# =========================
# Auth (required for login; fixes 401 if DB has no user yet)
# =========================
SECRET_KEY=your-secret-key-change-in-production
ADMIN_USER=marketlabs
ADMIN_PASSWORD=123456
ADMIN_EMAIL=hvsolanki27@gmail.com

# =========================
# Database (required for multi-user; 401 fix allows legacy login without DB user)
# =========================
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/zing

# =========================
# Demo / network
# =========================
IS_DEMO_MODE=false
PYTHON_API_HOST=0.0.0.0
PYTHON_API_PORT=5000
CORS_ORIGINS=*

# =========================
# Optional: AI/LLM (for analysis features)
# =========================
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# =========================
# Optional: Notifications / OAuth / etc.
# =========================
# SMTP_HOST= SMTP_USER= SMTP_PASSWORD=
# TURNSTILE_SITE_KEY= TURNSTILE_SECRET_KEY=
# GOOGLE_CLIENT_ID= GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID= GITHUB_CLIENT_SECRET=

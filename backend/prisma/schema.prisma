generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── User Model (for Privy auth) ───────────────────────────────

model User {
  id        String   @id @default(cuid())
  privyId   String   @unique
  wallet    String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([privyId])
  @@map("users")
}

// ─── Market Intelligence Models ───────────────────────────────

model MarketAsset {
  id          String   @id @default(cuid())
  symbol      String   @unique  // e.g., "frxEURUSD", "R_10", "cryBTCUSD"
  displayName String
  category    String   // "forex" | "crypto" | "commodities" | "indices"
  active      Boolean  @default(true)
  
  scans       MarketScan[]
  signals     PartnerSignal[]
  vitalityStats VitalityStats?
  timeframeAnalyses TimeframeAnalysis[]
  structuralAnalyses StructuralAnalysis[]
  decisionInquiries DecisionInquiry[]
  regimeAnalogies RegimeAnalogy[]
  newsArticles NewsArticle[]
  detectedPatterns DetectedPattern[]
  supportResistanceLevels SupportResistanceLevel[]
  aiAnalyses AiAnalysis[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([active])
  @@map("market_assets")
}

model MarketScan {
  id          String   @id @default(cuid())
  assetId     String
  timestamp   DateTime @default(now())
  
  // Price data
  price       Decimal  @db.Decimal(24, 12)
  change24h   Decimal? @db.Decimal(8, 4)
  volume24h   Decimal? @db.Decimal(24, 2)
  
  // Technical indicators
  rsi         Decimal? @db.Decimal(5, 2)
  macd        Decimal? @db.Decimal(10, 4)
  macdSignal  Decimal? @db.Decimal(10, 4)
  sma20       Decimal? @db.Decimal(24, 12)
  ema50       Decimal? @db.Decimal(24, 12)
  bbUpper     Decimal? @db.Decimal(24, 12)
  bbLower     Decimal? @db.Decimal(24, 12)
  adx         Decimal? @db.Decimal(5, 2)
  atr         Decimal? @db.Decimal(10, 4)
  
  // Composite scoring
  score       Decimal  @db.Decimal(5, 2)  // 0-100
  setupType   String?  // "bullish" | "bearish" | "neutral"
  momentum    Decimal? @db.Decimal(5, 2)  // -100 to +100
  
  // Enhanced confidence scoring (Acumen)
  patternConfidence    Decimal? @db.Decimal(5, 2)
  volumeConfidence    Decimal? @db.Decimal(5, 2)
  trendConfidence     Decimal? @db.Decimal(5, 2)
  indicatorConfidence Decimal? @db.Decimal(5, 2)
  overallConfidence   Decimal? @db.Decimal(5, 2)  // Weighted sum
  signalStrength      String?  // "strong" | "moderate" | "weak"
  
  // AI Analysis (optional, for full view)
  aiSummary   String?  @db.Text
  aiFull      String?  @db.Text
  
  asset       MarketAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  timeframeAnalyses TimeframeAnalysis[]
  structuralAnalyses StructuralAnalysis[]
  detectedPatterns DetectedPattern[]
  supportResistanceLevels SupportResistanceLevel[]
  aiAnalyses AiAnalysis[]
  
  @@index([assetId, timestamp])
  @@index([score])
  @@index([timestamp])
  @@map("market_scans")
}

model PartnerSignal {
  id          String   @id @default(cuid())
  assetId     String
  scanId      String
  timestamp   DateTime @default(now())
  
  signalText String   @db.Text  // Telegram-ready format
  score      Decimal  @db.Decimal(5, 2)
  sent       Boolean  @default(false)
  
  asset      MarketAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  @@index([timestamp])
  @@index([sent])
  @@map("partner_signals")
}

// ─── Enhanced Analysis Models ───────────────────────────────

model VitalityStats {
  id            String   @id @default(cuid())
  assetId       String   @unique
  gsr           Decimal? @db.Decimal(10, 4)  // Gold-to-Silver Ratio
  week52High    Decimal? @db.Decimal(24, 12)
  week52Low     Decimal? @db.Decimal(24, 12)
  deficit       String?  @db.Text  // e.g., "67 Million Ounces"
  rateSpread    Decimal? @db.Decimal(8, 2)  // Fed-ECB spread in bps
  updatedAt     DateTime @updatedAt
  
  asset         MarketAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  @@map("vitality_stats")
}

model TimeframeAnalysis {
  id            String   @id @default(cuid())
  assetId       String
  scanId        String
  timeframe     String   // "intraday" | "weekly" | "monthly"
  analysis      String   @db.Text
  verifiedDate  DateTime?
  createdAt     DateTime @default(now())
  
  asset         MarketAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  scan          MarketScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  
  @@index([assetId, timeframe])
  @@index([scanId])
  @@map("timeframe_analyses")
}

model StructuralAnalysis {
  id            String   @id @default(cuid())
  assetId       String
  scanId        String
  primaryDriver String  @db.Text
  structuralImpact String @db.Text
  marketNoise   String  @db.Text
  strategicBias String  @db.Text
  acceptanceLevel Decimal? @db.Decimal(24, 12)
  breachLevel   Decimal? @db.Decimal(24, 12)
  createdAt     DateTime @default(now())
  
  asset         MarketAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  scan          MarketScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  
  @@index([assetId])
  @@index([scanId])
  @@map("structural_analyses")
}

model DecisionInquiry {
  id            String   @id @default(cuid())
  assetId       String
  inquiry       String   @db.Text
  createdAt     DateTime @default(now())
  
  asset         MarketAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  @@index([assetId])
  @@map("decision_inquiries")
}

model RegimeAnalogy {
  id            String   @id @default(cuid())
  assetId       String
  period        String   // e.g., "1979-1980", "April 2011"
  description   String   @db.Text
  similarity    String   @db.Text
  createdAt     DateTime @default(now())
  
  asset         MarketAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  @@index([assetId])
  @@map("regime_analogies")
}

model NewsArticle {
  id            String   @id @default(cuid())
  assetId       String?
  title         String
  source        String
  url           String?
  content       String?  @db.Text
  publishedAt   DateTime
  fetchedAt     DateTime @default(now())
  
  // Enhanced fields (inspired by cur8-news)
  sentiment     String?  // "bullish" | "bearish" | "neutral" | "mixed"
  keyFacts      Json?    // Array of key facts extracted from article
  summary       String?  @db.Text  // AI-generated summary
  
  asset         MarketAsset? @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  @@index([assetId])
  @@index([publishedAt])
  @@index([source])
  @@index([sentiment])
  @@map("news_articles")
}

// ─── Job Queue Models ───────────────────────────────

model ScanJob {
  id            String   @id @default(cuid())
  status        String   // "pending" | "processing" | "completed" | "failed"
  progress      Int      @default(0)  // 0-100
  totalAssets   Int?
  scannedAssets Int      @default(0)
  results       Json?    // Store scan results
  error         String?
  createdAt     DateTime @default(now())
  completedAt   DateTime?
  
  @@index([status])
  @@index([createdAt])
  @@map("scan_jobs")
}

// ─── Acumen Analysis Models ───────────────────────────────

model DetectedPattern {
  id            String   @id @default(cuid())
  scanId        String
  assetId       String
  patternType   String   // "chart" | "candlestick"
  patternName   String   // e.g., "Head & Shoulders"
  direction     String   // "bullish" | "bearish" | "neutral"
  confidence    Decimal  @db.Decimal(5, 2)  // 0-100
  detectedAt    DateTime @default(now())
  metadata      Json?    // Pattern-specific data (pivot points, etc.)
  
  scan          MarketScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  asset         MarketAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  @@index([scanId])
  @@index([assetId, detectedAt])
  @@map("detected_patterns")
}

model SupportResistanceLevel {
  id          String   @id @default(cuid())
  scanId      String
  assetId     String
  level       Decimal  @db.Decimal(24, 12)
  type        String   // "support" | "resistance"
  strength    Int      // Number of touches
  proximity   Decimal  @db.Decimal(5, 2)  // Distance from current price %
  detectedAt  DateTime @default(now())
  
  scan        MarketScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  asset       MarketAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  @@index([scanId])
  @@index([assetId, type])
  @@map("support_resistance_levels")
}

model AiAnalysis {
  id            String   @id @default(cuid())
  scanId        String
  assetId       String
  analysisType  String   // "pattern_review" | "comprehensive"
  model         String   // "claude-3.5-sonnet" | "grok-beta"
  confidence    Decimal? @db.Decimal(5, 2)
  analysis      String   @db.Text
  entryStrategy String?  @db.Text
  exitStrategy  String?  @db.Text
  createdAt     DateTime @default(now())
  
  scan          MarketScan @relation(fields: [scanId], references: [id], onDelete: Cascade)
  asset         MarketAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  @@index([scanId])
  @@map("ai_analyses")
}

